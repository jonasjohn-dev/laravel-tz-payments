{
    "name": "jonasjohn/laravel-tz-payments",
    "description": "One Laravel API for Tanzanian payment gateways: ClickPesa, AzamPay and Pesapal.",
    "keywords": ["laravel", "tanzania", "payments", "mobile-money", "clickpesa", "azampay", "pesapal", "mpesa", "ussd"],
    "homepage": "https://github.com/jonasjohn-dev/laravel-tz-payments",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Jonas Tumain John",
            "homepage": "https://github.com/jonasjohn-dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "ext-openssl": "*",
        "guzzlehttp/guzzle": "^7.5",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/events": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^2.9|^3.0",
        "laravel/pint": "^1.13",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "pestphp/pest": "^2.0|^3.0|^4.0|^5.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0|^4.0|^5.0"
    },
    "autoload": {
        "psr-4": {
            "JonasJohn\\TzPayments\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JonasJohn\\TzPayments\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JonasJohn\\TzPayments\\TzPaymentsServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
